<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="500.0"
      prefWidth="700.0"
      spacing="12.0"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.imc.IMCController">

    <children>

        <!-- Título -->
        <Label text="Calculadora de IMC">
            <font>
                <Font size="24.0" />
            </font>
        </Label>


        <!-- Área dos dados e resultado -->
        <HBox spacing="40.0">

            <!-- Dados da pessoa -->
            <VBox prefWidth="350.0" spacing="8.0">

                <Label prefWidth="68.0" text="Nome">
                    <font>
                        <Font size="18.0" />
                    </font>
                </Label>

                <TextField fx:id="campoNome" prefHeight="30.0" prefWidth="300.0" promptText="Digite o nome">
                    <font>
                        <Font size="14.0" />
                    </font>
                </TextField>


                <Label text="Altura">
                    <font>
                        <Font size="18.0" />
                    </font>
                </Label>

                <TextField fx:id="campoAltura" prefHeight="30.0" prefWidth="300.0" promptText="Digite a altura em metros">
                    <font>
                        <Font size="14.0" />
                    </font>
                </TextField>


                <Label text="Peso">
                    <font>
                        <Font size="18.0" />
                    </font>
                </Label>

                <TextField fx:id="campoPeso" prefHeight="30.0" prefWidth="300.0" promptText="Digite o peso em kg">
                    <font>
                        <Font size="14.0" />
                    </font>
                </TextField>

            </VBox>


            <!-- Resultado do IMC -->
            <VBox prefWidth="250.0" spacing="10.0">

                <Label alignment="CENTER" text="       Resultado do IMC">
                    <font>
                        <Font name="Arial Black" size="20.0" />
                    </font>
                </Label>
      
                <Label fx:id="labelResultado" alignment="TOP_CENTER" prefHeight="100.0" prefWidth="250.0" text=" " textFill="RED" wrapText="true">
               <font>
                  <Font size="17.0" />
               </font>
            </Label>

            </VBox>

        </HBox>


        <!-- Botões -->
        <HBox spacing="20.0">

            <Button fx:id="botaoCalcular" mnemonicParsing="false" onAction="#calcularIMC" prefHeight="30.0" prefWidth="110.0" text="Calcular IMC" />

            <Button fx:id="botaoSalvar" mnemonicParsing="false" onAction="#salvar" prefHeight="30.0" prefWidth="80.0" text="Salvar" />

            <Button fx:id="botaoCarregar" mnemonicParsing="false" onAction="#carregar" prefHeight="30.0" prefWidth="130.0" text="Carregar dados" />

        </HBox>


        <!-- Tabela -->
        <TableView fx:id="tabelaPessoas" prefHeight="200.0" prefWidth="700.0">

            <columns>

                <TableColumn fx:id="colunaNome" prefWidth="150.0" text="Nome" />

                <TableColumn fx:id="colunaAltura" prefWidth="100.0" text="Altura" />

                <TableColumn fx:id="colunaPeso" prefWidth="100.0" text="Peso" />

                <TableColumn fx:id="colunaImc" prefWidth="100.0" text="IMC" />

                <TableColumn fx:id="colunaClassificacao" prefWidth="248.80001831054688" text="Classificação" />

            </columns>

        </TableView>

    </children>

</VBox>
